# LLM provider (OpenAI-compatible). Leave LLM_API_KEY empty to run the demo in
# offline mode: the deterministic BM25 router picks skills and every trace is
# labelled mode="offline".
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# USD per 1M tokens, used to compute the cost recorded for each call.
PRICE_INPUT_PER_M=0.27
PRICE_OUTPUT_PER_M=1.10

# Skill section budget inside the system prompt.
PROMPT_BUDGET_TOKENS=800
DESCRIPTION_TRUNCATE_CHARS=160

# Backend port (Vite proxies /api and /health here).
PORT=8787
